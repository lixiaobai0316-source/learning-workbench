#!/bin/bash
# 学习工作台 - 手机访问服务器启动脚本
# 双击此文件即可启动，手机 Safari 访问后添加到主屏幕

cd "$(dirname "$0")"
echo "============================================"
echo "  📚 学习工作台 - 手机访问服务已启动"
echo "============================================"
echo ""
echo "  📱 手机操作步骤："
echo "  1. 确保 iPhone 和本机连接同一 WiFi"
echo "  2. 打开 Safari"
echo "  3. 输入地址：http://192.168.88.10:8888/学习工作台.html"
echo "  4. 点击底部「分享」按钮 ⬆️"
echo "  5. 选择「添加到主屏幕」"
echo "  6. 桌面出现图标，一点就打开"
echo ""
echo "  ⚠️  保持此窗口打开，手机才能访问"
echo "  ⚠️  关闭窗口即停止服务"
echo ""
echo "  正在运行中... 按 Ctrl+C 停止"
echo "============================================"
echo ""
python3 -m http.server 8888 --bind 0.0.0.0
